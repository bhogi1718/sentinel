# Server
NODE_ENV=development
PORT=5000

# Database - Neon connection string (Neon dashboard -> your project ->
# Connection Details -> "Pooled connection" toggled off). No SSH tunnel
# needed locally or in production; Neon is reachable directly over TLS.
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_PASSWORD@YOUR_NEON_HOST.neon.tech/sentinel?sslmode=require"

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS - comma-separated list of allowed frontend origins. Include your
# Vercel production domain plus localhost for local dev against a
# deployed backend, e.g.:
# CORS_ORIGIN=https://sentinel.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Single administrator seed values (used only by `npm run seed`)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-before-seeding

# Laptop agent device seed value (used only by `npm run seed`)
DEVICE_NAME=My Laptop

# Telegram notifications are configured in-app now (Settings -> Integrations)
# rather than via .env - the bot token and chat ID are stored in the
# database and can be connected/disconnected without a redeploy.
