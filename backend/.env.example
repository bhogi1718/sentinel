# Server
NODE_ENV=development
PORT=5000

# Database (via SSH tunnel to sentinel-server EC2 when developing locally:
# ssh -i sentinel-key.pem -L 5432:localhost:5432 ubuntu@54.83.231.177)
DATABASE_URL="postgresql://sentinel_admin:YOUR_PASSWORD@localhost:5432/sentinel?schema=public"

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS - the frontend origin(s) allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Single administrator seed values (used only by `npm run seed`)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-before-seeding

# Laptop agent device seed value (used only by `npm run seed`)
DEVICE_NAME=My Laptop

# Telegram notifications are configured in-app now (Settings -> Integrations)
# rather than via .env - the bot token and chat ID are stored in the
# database and can be connected/disconnected without a redeploy.
