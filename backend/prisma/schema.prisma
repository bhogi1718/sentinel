generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A person who can sign in. What they can see and do is decided entirely
/// by their memberships - a user with no membership has access to nothing.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens     RefreshToken[]
  memberships       Membership[]
  requestedCommands Command[]
  auditEvents       AuditEvent[]
  sentInvitations   Invitation[]   @relation("InvitationCreator")
  pairingCodes      PairingCode[]  @relation("PairingCodeCreator")

  @@map("users")
}

/// Refresh tokens are persisted (rather than trusted purely as signed
/// JWTs) so an individual session can be revoked on demand - e.g. if
/// a phone is lost, all outstanding sessions can be killed without
/// waiting for token expiry.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Every token rotated from one sign-in shares this id. Presenting a token
  /// that was already rotated means it was copied, so the family is revoked.
  /// Null only on rows created before families existed (backfilled to id).
  familyId  String?
  expiresAt DateTime
  /// Set when the token was used to get a new pair (rotation).
  rotatedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Ordered from least to most privileged - see common/permissions.ts for
/// what each role is allowed to do.
enum OrgRole {
  VIEWER
  ADMIN
  OWNER
}

/// The tenant boundary. Every device, event and command belongs to exactly
/// one organization, and nothing is ever visible across organizations.
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  /// The public demo organization: its devices are simulated, and only
  /// demo sessions can reach it. See docs/architecture/demo-mode.md.
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  devices     Device[]
  settings    OrganizationSettings?
  auditEvents AuditEvent[]
  invitations  Invitation[]
  pairingCodes PairingCode[]

  @@map("organizations")
}

/// A user's role within one organization. A user can belong to several
/// organizations, with a different role in each.
model Membership {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role      OrgRole
  createdAt DateTime     @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("memberships")
}

/// A link that lets whoever holds it join an organization with a fixed
/// role (ADMIN or VIEWER - owners are made by promotion, not invitation).
/// Only a hash of the link's token is stored. Single-use: acceptedAt is set
/// when it's used; it can also expire or be revoked. There's no outbound
/// email, so the owner shares the link themselves.
model Invitation {
  id           String       @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role         OrgRole
  tokenHash    String       @unique
  /// Who it's for, as the owner described them - a label only.
  note         String?
  createdById  String?
  createdBy    User?        @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  /// The member it created; kept as a plain id so removing that member
  /// later leaves the record of the invite intact.
  acceptedById String?
  revokedAt    DateTime?

  @@index([orgId])
  @@map("invitations")
}

/// A short code that lets an agent register a new device in an
/// organization without anyone copying its token by hand. An Owner or Admin
/// creates it (naming the device); the agent exchanges it once for the new
/// device's token. Only a hash is stored; it expires after 15 minutes.
/// See docs/architecture/device-pairing.md.
model PairingCode {
  id          String       @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deviceName  String
  codeHash    String       @unique
  createdById String?
  createdBy   User?        @relation("PairingCodeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  /// The device it created; a plain id, so removing that device later
  /// leaves this record alone.
  deviceId    String?

  @@index([orgId])
  @@map("pairing_codes")
}

/// Per-organization configuration that can change without a redeploy
/// (currently just the Telegram integration). At most one row per org.
model OrganizationSettings {
  id               String       @id @default(uuid())
  orgId            String       @unique
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  telegramBotToken String?
  telegramChatId   String?
  updatedAt        DateTime     @updatedAt

  @@map("organization_settings")
}

/// A laptop running the Sentinel Rust agent. The agent authenticates with
/// its own token (stored hashed), which also determines its organization.
model Device {
  id         String       @id @default(uuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String       @unique
  isOnline   Boolean      @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime     @default(now())

  events   Event[]
  commands Command[]

  // Target of the composite foreign keys on Event and Command: they
  // reference (id, orgId) together, so the database itself rejects a row
  // whose orgId doesn't match its device's organization.
  @@unique([id, orgId])
  @@index([orgId])
  @@map("devices")
}

enum EventType {
  BOOT
  SHUTDOWN
  RESTART
  LOCK
  UNLOCK
  SLEEP
  WAKE
  INTERNET_CONNECTED
  INTERNET_DISCONNECTED
  BATTERY_LOW
}

/// A system event reported by a device's agent. Persisted first, then
/// broadcast to the organization's dashboards and sent to Telegram -
/// persistence is the source of truth, the live push is a convenience on
/// top of it. orgId is copied from the device so organization-wide event
/// lists filter on an indexed column of this table.
model Event {
  id         String    @id @default(uuid())
  orgId      String
  deviceId   String
  device     Device    @relation(fields: [deviceId, orgId], references: [id, orgId], onDelete: Cascade)
  type       EventType
  metadata   Json?
  occurredAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([deviceId, occurredAt])
  @@index([orgId, occurredAt])
  @@map("events")
}

enum CommandType {
  LOCK
  RESTART
  SHUTDOWN
  SLEEP
  LOG_OFF
  KILL_PROCESS
}

enum CommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  FAILED
}

/// A remote action requested from the dashboard. Persisted immediately on
/// request (before delivery is even attempted) so there's always a record
/// of what was asked for, by whom and when, independent of whether the
/// agent was reachable to carry it out. targetPid/targetName are only set
/// for KILL_PROCESS - every other command type acts on the whole machine.
/// requestedById is null for commands recorded before requesters were
/// tracked, or whose requester has since been deleted.
model Command {
  id             String        @id @default(uuid())
  orgId          String
  deviceId       String
  device         Device        @relation(fields: [deviceId, orgId], references: [id, orgId], onDelete: Cascade)
  requestedById  String?
  requestedBy    User?         @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  type           CommandType
  targetPid      Int?
  targetName     String?
  status         CommandStatus @default(PENDING)
  errorMessage   String?
  requestedAt    DateTime      @default(now())
  acknowledgedAt DateTime?

  @@index([deviceId, requestedAt])
  @@index([orgId, requestedAt])
  @@map("commands")
}

/// What the audit log records: the sensitive actions a member can take on
/// a device - each exposes the device owner's private data or changes the
/// machine - and every change to who belongs to the organization.
enum AuditAction {
  SCREENSHOT_CAPTURED
  LIVE_VIEW_STARTED
  LIVE_VIEW_ENDED
  FILES_LISTED
  FILE_DOWNLOADED
  COMMAND_SENT
  MEMBER_INVITED
  INVITE_REVOKED
  MEMBER_JOINED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  MEMBER_LEFT
  DEVICE_REMOVED
  DEVICE_ADDED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

/// Who did what to which device, and whether it worked: the record an
/// organization's owners and admins review. Append-only - the database
/// rejects any UPDATE (see the migration), and rows are only ever deleted
/// by retention (modules/audit/auditRetention.ts) or with their
/// organization.
///
/// The actor's email and the device's name are copied at write time, and
/// deviceId deliberately has no foreign key: removing a member or a device
/// must not rewrite or erase the history of what was done with it.
model AuditEvent {
  id         String       @id @default(uuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  action     AuditAction
  outcome    AuditOutcome
  deviceId   String?
  deviceName String?
  /// Action-specific detail: the folder or file path, the command, the
  /// live view's duration, or the reason it failed.
  detail     Json?
  occurredAt DateTime     @default(now())

  @@index([orgId, occurredAt])
  @@index([occurredAt])
  @@map("audit_events")
}
