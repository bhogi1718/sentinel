# Leave both unset for local dev - Vite's dev server proxies /api and
# /socket.io to a local backend on port 5000 (see vite.config.ts), so
# relative paths just work.
#
# Set both once the frontend and backend are deployed to separate hosts
# (e.g. Vercel + Render). No trailing slash.
VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_SOCKET_URL=https://your-backend.onrender.com
